; The infrared LED's carrier (irtx.c): the TX FIFO alternates the length
; of a pulse and of the gap after it, each in carrier periods, minus one.
; A period is 32 cycles -- 16 on, 16 off while pulsing: 50%, not the
; usual 33%, for more light per burst (the LED's current is set by its
; 22 ohm resistor, ~85mA) -- so the state machine runs at 32 x the carrier.
; Waiting for the next pulse, the LED is off.

.program ir_carrier
.wrap_target
    pull block
    out x, 32
pulse:
    set pins, 1 [15]
    set pins, 0 [14]
    jmp x-- pulse
    pull block
    out x, 32
gap:
    nop [30]
    jmp x-- gap
.wrap

; The HP 82240B printer's frames (irtx_send_redeye()): each bit from the
; OSR (autopulled, 30 a word: one frame) is a half-bit time, 14 periods of
; 32768 Hz -- 448 cycles here, run at 32 x 32768 Hz. A 1 starts it with a
; burst of 8 periods at 50%, a 0 is dark. Every half-bit takes exactly 448
; cycles whichever it is: the printer wants the bursts seven half-bits
; apart within 1% of nominal (the pulse/gap program above gains 4 cycles
; at every switch). Between frames, waiting for the next word, it's dark.

.program redeye
.wrap_target
    out x, 1
    jmp !x dark
    set y, 7
burst:
    set pins, 1 [15]
    set pins, 0 [14]
    jmp y-- burst            ; 3 + 8 x 32 = 259 cycles so far
    set y, 4 [28]            ; + 29 + 5 x 32 = 448
delay:
    nop [30]
    jmp y-- delay
.wrap
dark:
    set y, 12 [28]           ; 2 + 29 + 1 + 13 x 32 = 448
    jmp delay
